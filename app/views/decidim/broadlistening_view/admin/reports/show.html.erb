<% add_decidim_page_title(translated_attribute(report.title)) %>
<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= translated_attribute(report.title) %>
    <div class="ml-auto flex gap-2">
      <% unless report.published? %>
        <%= link_to t(".publish"), publish_report_path(report), method: :post, class: "button button__sm button__secondary" %>
      <% end %>
      <%= link_to t(".edit"), edit_report_path(report), class: "button button__sm button__transparent-secondary" %>
    </div>
  </h1>
</div>

<div class="card mt-4">
  <div class="card-section">
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <dt class="text-sm text-gray"><%= t(".status") %></dt>
        <dd class="mt-1">
          <% if report.published? %>
            <span class="label bg-success text-white"><%= t(".status_published") %></span>
          <% else %>
            <span class="label bg-gray text-white"><%= t(".status_draft") %></span>
          <% end %>
        </dd>
      </div>

      <div>
        <dt class="text-sm text-gray"><%= t(".created_at") %></dt>
        <dd class="mt-1"><%= l(report.created_at, format: :long) %></dd>
      </div>

      <% if translated_attribute(report.description).present? %>
        <div class="md:col-span-2">
          <dt class="text-sm text-gray"><%= t(".description") %></dt>
          <dd class="mt-1"><%= simple_format(translated_attribute(report.description)) %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>

<% if report.has_data? %>
  <div class="card mt-4">
    <div class="card-section">
      <h3 class="text-lg font-semibold mb-4"><%= t(".data_summary") %></h3>
      <dl class="grid grid-cols-2 gap-4">
        <div>
          <dt class="text-sm text-gray"><%= t(".arguments_count") %></dt>
          <dd class="mt-1 text-xl font-bold"><%= format_count(report.arguments.size) %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray"><%= t(".clusters_count") %></dt>
          <dd class="mt-1 text-xl font-bold"><%= format_count(report.clusters.size) %></dd>
        </div>
      </dl>
    </div>
  </div>

  <% if report.overview.present? %>
    <div class="card mt-4">
      <div class="card-section">
        <h3 class="text-lg font-semibold mb-4"><%= t(".overview") %></h3>
        <%= simple_format(report.overview) %>
      </div>
    </div>
  <% end %>

  <div class="card mt-4">
    <div class="card-section">
      <h3 class="text-lg font-semibold mb-4"><%= t(".preview") %></h3>
      <%= append_javascript_pack_tag "decidim_broadlistening_view" %>
      <%= broadlistening_view_js_config %>

      <script id="report-data-<%= report.id %>" type="application/json">
        <%= raw report.result_data.to_json %>
      </script>

      <div data-broadlistening-view-manager
           data-data-source="report-data-<%= report.id %>"
           style="height: 500px;">
      </div>
    </div>
  </div>

  <% if report.top_level_clusters.any? %>
    <div class="card mt-4">
      <div class="card-section">
        <h3 class="text-lg font-semibold mb-4"><%= t(".cluster_list") %></h3>
        <div class="table-stacked">
          <table class="table-list">
            <thead>
              <tr>
                <th style="width: 40px;"></th>
                <th><%= t(".cluster_label") %></th>
                <th><%= t(".cluster_count") %></th>
                <th><%= t(".cluster_takeaway") %></th>
              </tr>
            </thead>
            <tbody>
              <% report.hierarchical_clusters.each_with_index do |item, index| %>
                <% cluster = item[:cluster] %>
                <tr style="background-color: <%= cluster_color(index) %>20;">
                  <td>
                    <span style="display: inline-block; width: 16px; height: 16px; border-radius: 50%; background-color: <%= cluster_color(index) %>;"></span>
                  </td>
                  <td><strong><%= cluster["label"] %></strong></td>
                  <td><%= cluster["value"] %></td>
                  <td><%= cluster["takeaway"] %></td>
                </tr>
                <% item[:children].each do |child_item| %>
                  <% child = child_item[:cluster] %>
                  <tr>
                    <td></td>
                    <td style="padding-left: 24px;"><%= child["label"] %></td>
                    <td><%= child["value"] %></td>
                    <td><%= child["takeaway"] %></td>
                  </tr>
                  <% child_item[:children].each do |grandchild_item| %>
                    <% grandchild = grandchild_item[:cluster] %>
                    <tr>
                      <td></td>
                      <td style="padding-left: 48px; color: #666;"><%= grandchild["label"] %></td>
                      <td><%= grandchild["value"] %></td>
                      <td style="color: #666;"><%= grandchild["takeaway"] %></td>
                    </tr>
                  <% end %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
