<% add_decidim_page_title(report.title) %>
<%= append_javascript_pack_tag "decidim_broadlistening_view" %>
<%= append_stylesheet_pack_tag "decidim_broadlistening_view" %>
<%= broadlistening_view_js_config %>

<%= render layout: "layouts/decidim/shared/layout_center", locals: { columns: 10 } do %>

  <section class="layout-main__section layout-main__heading">
    <div class="flex justify-center">
      <h1 class="title-decorator my-8"><%= report.title %></h1>
    </div>

    <div class="text-center text-gray mb-8">
      <%= t("decidim.broadlistening_view.reports.show.analyzed_comments", count: report.comment_num) %>
      ·
      <%= l(report.created_at, format: :long) %>
    </div>
  </section>

  <% if report.overview.present? %>
    <section class="layout-main__section">
      <h3 class="h4 decorator mb-4"><%= t("decidim.broadlistening_view.reports.show.overview") %></h3>
      <div class="editor-content">
        <%= simple_format(report.overview) %>
      </div>
    </section>
  <% end %>

  <% if report.has_data? %>
    <section class="layout-main__section">
      <script id="report-data-<%= report.id %>" type="application/json">
        <%= raw report.result_data.to_json %>
      </script>

      <div data-broadlistening-view-manager
           data-data-source="report-data-<%= report.id %>"
           id="chart-container-<%= report.id %>">
      </div>

      <p class="text-sm text-gray text-center mt-2">
        <%= t("decidim.broadlistening_view.reports.show.chart_help") %>
      </p>
    </section>

    <% if report.top_level_clusters.any? %>
      <section class="layout-main__section" id="cluster-overview-section">
        <h3 class="h4 decorator mb-4"><%= t("decidim.broadlistening_view.reports.show.cluster_overview") %></h3>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4" id="cluster-grid">
          <% report.top_level_clusters.each_with_index do |cluster, index| %>
            <div class="card p-4 hover:shadow-md transition-shadow cursor-pointer"
                 style="border-left: 4px solid <%= cluster_color(index) %>;"
                 data-cluster-id="<%= cluster["id"] %>"
                 title="<%= t("decidim.broadlistening_view.js.cluster.click_to_expand") %>">
              <div class="flex items-center gap-3 mb-2">
                <span class="inline-block w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= cluster_color(index) %>;"></span>
                <span class="font-semibold text-sm line-clamp-2"><%= cluster["label"] %></span>
              </div>
              <div class="flex items-center gap-2 mb-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium" style="background-color: <%= cluster_color(index) %>20; color: <%= cluster_color(index) %>;">
                  <%= t("decidim.broadlistening_view.reports.show.cluster_count", count: cluster["value"]) %>
                </span>
              </div>
              <% if cluster["takeaway"].present? %>
                <p class="text-gray-2 text-sm line-clamp-3"><%= cluster["takeaway"] %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>

<% end %>
